{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@1.10.1"]
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.83"]
    },
    "notebooklm": {
      "command": "agyo",
      "args": ["notebooklm", "mcp"]
    }
  }
}
